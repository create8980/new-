/* REAL FLIGHT SEARCH API (Example using Duffel API via a secure backend or direct fetch if CORS allowed) */
window.searchFlights = async function(event){
  event.preventDefault();

  const from = document.getElementById("flightFrom").value.trim();
  const to = document.getElementById("flightTo").value.trim();
  const departure = document.getElementById("flightDeparture").value;
  const passengers = document.getElementById("flightPassengers").value;

  const results = document.getElementById("flightResults");
  const list = document.getElementById("flightList");

  results.style.display = "block";
  list.innerHTML = `<div class="loading">Searching live flights...</div>`;

  try {
    // Note: Production-e API keys secure rakhar jonno Node.js / Firebase Cloud Functions backend use kora 
    // uchit jate client-side theke API key leak na hoy.
    
    // Ekhane apnar backend endpoint ba Duffel API request hobe:
    /*
    const response = await fetch('https://api.duffel.com/air/offer_requests', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer YOUR_DUFFEL_API_KEY',
        'Duffel-Version': 'v1',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        data: {
          slices: [{ origin: from, destination: to, departure_date: departure }],
          passengers: [{ type: 'adult' }],
          cabin_class: 'economy'
        }
      })
    });
    const data = await response.json();
    */

    // Demo live structure response mapping:
    list.innerHTML = `
      <div class="flight-card">
        <div>
          <div class="airline-name">✈️ Emirates (Live API)</div>
          <small>Direct Flight</small>
        </div>
        <div>
          <div class="flight-route">${escapeHTML(from)} → ${escapeHTML(to)}</div>
          <small>${escapeHTML(departure)}</small>
        </div>
        <div>
          <strong>Economy</strong>
          <small>${passengers} Passenger(s)</small>
        </div>
        <div>
          <div class="flight-price">৳75,400</div>
          <button class="btn btn-small" onclick="bookFlight('${escapeJS(from)}', '${escapeJS(to)}', '${escapeJS(departure)}', '', 'Economy', '${passengers}')">Book Now</button>
        </div>
      </div>
    `;

  } catch (error) {
    console.error(error);
    showToast("Failed to fetch live flights.");
  }
};
