rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Users can create bookings and read/write their own bookings
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.data.uid;
    }
    // Anyone can send contact messages
    match /messages/{messageId} {
      allow create: if true;
    }
  }
}
